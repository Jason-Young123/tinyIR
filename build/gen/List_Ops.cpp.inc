  ::mlir::OpAsmParser::UnresolvedOperand itemRawOperand{};
  ::llvm::ArrayRef<::mlir::OpAsmParser::UnresolvedOperand> itemOperands(&itemRawOperand, 1);  ::llvm::SMLoc itemOperandsLoc;
  (void)itemOperandsLoc;
  ::mlir::Type inputRawType{};
  ::llvm::ArrayRef<::mlir::Type> inputTypes(&inputRawType, 1);

  inputOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperand(inputRawOperand))
    return ::mlir::failure();
  if (parser.parseComma())
    return ::mlir::failure();

  itemOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperand(itemRawOperand))
